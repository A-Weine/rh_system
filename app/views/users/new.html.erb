<h1><%= User.exists?(access_level: 'admin') ? 'Criar Novo Usuário' : 'Criar Novo Administrador' %></h1>

<%= form_with model: @user, local: true do |form| %>
  <div class="form-group">
    <%= form.label :name, "Nome" %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :email, "Email" %>
    <%= form.email_field :email, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :password, "Senha" %>
    <%= form.password_field :password, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :password_confirmation, "Confirme a Senha" %>
    <%= form.password_field :password_confirmation, class: "form-control" %>
  </div>

  <% if User.exists?(access_level: 'admin') %>
    <div class="form-group">
      <%= form.label :access_level, "Nível de Acesso" %>
      <%= form.select :access_level, User.access_levels.keys.map { |level| [level.titleize, level] }, {}, class: "form-control" %>
    </div>
  <% else %>
    <!-- Se não há admins, define o nível de acesso como admin -->
    <%= form.hidden_field :access_level, value: 'admin' %>
  <% end %>

  <% if User.exists?(access_level: 'admin') %>
    <div class="form-group">
      <%= form.label :department_ids, "Departamentos" %>
      <%= form.collection_select :department_ids, Department.all, :id, :name, {}, { multiple: true, class: "form-control" } %>
    </div>
  <% end %>

  <%= form.submit "Criar", class: "btn btn-primary" %>
<% end %>

<%= link_to "Voltar", user_signed_in? ? users_path : root_path, class: "btn btn-secondary" %>

<% if (n = notice).present? %><p class="alert alert-warning"><%= n %></p><% end %>

<div class="container mt-5">
  <div class="row flex-centered">
    <div class="col-md-6">
      <div class="card">
        <div class="card-header text-center">
          <h2>Logar-se</h2>
        </div>
        <div class="card-body">
          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "form-horizontal" }) do |f| %>
            
            <div class="form-group">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "Seu e-mail" %>
            </div>

            <div class="form-group">
              <%= f.label :password, class: "form-label" %>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Sua senha" %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="form-check mb-3">
                <%= f.check_box :remember_me, class: "form-check-input" %>
                <%= f.label :remember_me, class: "form-check-label" %>
              </div>
            <% end %>

            <div class="form-group text-center">
              <%= f.submit "Entrar", class: "btn btn-primary btn-block" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="text-center mt-3">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>

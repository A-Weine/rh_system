<div class="card mb-4">
  <div class="card-header bg-primary text-white card-header-view">
    <h4 class="mb-0">Informações do Departamento: <strong><%= department.name %></strong></h4>
  </div>
  
  <div class="card-body">
    <hr>
    <div class="row">
      <div class="col-md-6">
        <p><strong>Código:</strong> <%= department.code %></p>
        <p><strong>Nome:</strong> <%= department.name %></p>
        <p><strong>Localização:</strong> <%= department.location %></p>
        <p><strong>Status:</strong> <%= department.status %></p>
      </div>
    </div>
    <hr>
  </div>

  <div class="card-body">
    <div class="card-header bg-primary text-white card-header-view">
      <h4 class="mb-0">Descrição do Departamento</h4>
    </div>
    <hr>
    <div class="row">
      <div class="col-md-12">
        <p><strong>Descrição:</strong> <%= department.description %></p>
      </div>
    </div>
    <hr>
  </div>
</div>

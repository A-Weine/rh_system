<div class="card mb-4">
  <div class="card-header bg-primary text-white card-header-view">
    <h4 class="mb-0">Informações do Cargo: <strong><%= position.name %></strong></h4>
  </div>
  
  <div class="card-body">

    <hr>

    <div class="row">
      <div class="col-md-6">
        <p><strong>Nome:</strong> <%= position.name %></p>
        <p><strong>Departamento:</strong> <%= position.department.name %></p>
        <p><strong>Salário Base:</strong> <%= number_to_currency(position.base_salary) %></p>
        <p><strong>Nível:</strong> <%= position.level %></p>
        <p><strong>Status:</strong> <%= position.status %></p>
      </div>
    </div>

    <hr>

  </div>

  <div class="card-body">
    <div class="card-header bg-primary text-white card-header-view">
      <h4 class="mb-0">Descrição do cargo</h4>
    </div>

    <hr>

    <div class="row">
      <div class="col-md-12">
        <p><strong>Descrição:</strong> <%= position.description %></p>
      </div>
    </div>

    <hr>

  </div>

  <div class="card-body">
    <div class="card-header bg-primary text-white card-header-view">
      <h4 class="mb-0">Requisitos do Cargo</h4>
    </div>

    <hr>

    <div class="row">
      <div class="col-md-12">
        <p><strong>Requisitos:</strong> <%= position.requirements %></p>
      </div>
    </div>

    <hr>

  </div>

  <div class="card-body">
    <div class="card-header bg-primary text-white card-header-view">
      <h4 class="mb-0">Benefícios do Cargo</h4>
    </div>
    
    <hr>

    <div class="row">
      <div class="col-md-12">
        <p><strong>Benefícios:</strong> <%= position.benefits %></p>
      </div>
    </div>

    <hr>
    
  </div>
</div>
